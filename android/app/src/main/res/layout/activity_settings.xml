<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingBottom="80dp">
        <LinearLayout android:orientation="vertical" android:padding="20dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="⚙️ Settings" android:textColor="@color/text_primary"
                android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="20dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="🐍 Python: In-App Mode"
                android:textColor="@color/success" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Saari libraries app ke andar (Termux nahi chahiye)"
                android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="15dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnTestLibs" android:text="🧪 TEST PYTHON LIBRARIES"
                style="@style/Widget.TelegramHost.Button" android:backgroundTint="@color/success"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ScrollView android:layout_marginTop="10dp" android:maxHeight="200dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/tvTestResult" android:text=""
                    android:textColor="@color/terminal_text" android:fontFamily="monospace" android:textSize="11sp"
                    android:padding="10dp" android:background="@color/terminal_bg"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </ScrollView>
            <View android:layout_marginTop="25dp" android:background="@color/text_secondary"
                android:layout_width="match_parent" android:layout_height="1dp"/>
            <TextView android:text="📤 SHARE AND ACCOUNT" android:textColor="@color/text_primary"
                android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="20dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnShareApp" android:text="🔗 SHARE THIS APP"
                style="@style/Widget.TelegramHost.Button" android:backgroundTint="@color/info"
                android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnProfile" android:text="👤 MY PROFILE"
                style="@style/Widget.TelegramHost.Button" android:backgroundTint="@color/accent"
                android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnLogout" android:text="🚪 LOGOUT"
                style="@style/Widget.TelegramHost.Button" android:backgroundTint="@color/danger"
                android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_gravity="bottom"
        android:background="@color/bg_card"
        app:itemIconTint="@color/accent"
        app:itemTextColor="@color/accent"
        app:menu="@menu/bottom_nav_menu"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
