<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout android:layout_centerInParent="true"
        android:orientation="vertical" android:gravity="center"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageView android:id="@+id/logo"
            android:src="@mipmap/ic_launcher"
            android:layout_width="140dp" android:layout_height="140dp"/>
        <TextView android:id="@+id/title" android:text="Telegram Host"
            android:textColor="@color/text_primary" android:textSize="32sp"
            android:textStyle="bold" android:layout_marginTop="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Premium Bot Hosting" android:textColor="@color/accent"
            android:textSize="14sp" android:layout_marginTop="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:text="v1.0 • Loading..." android:textColor="@color/text_secondary"
        android:layout_alignParentBottom="true" android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp" android:textSize="12sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</RelativeLayout>
