<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
<LinearLayout android:orientation="vertical" android:padding="15dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/tvName" android:textColor="@color/text_primary"
        android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="15dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btnStop" android:text="⏹ Stop" style="@style/Widget.TelegramHost.Button"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnRestart" android:text="🔄" style="@style/Widget.TelegramHost.Button"
            android:layout_weight="1" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/btnSleep" android:text="💤 Sleep" style="@style/Widget.TelegramHost.Button"
            android:backgroundTint="@color/warning"
            android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnDelete" android:text="🗑" style="@style/Widget.TelegramHost.Button"
            android:backgroundTint="@color/danger"
            android:layout_weight="1" android:layout_marginStart="6dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="15dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="📜 Live Logs (auto-refresh)" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnLogs" android:text="🔄 Refresh" style="@style/Widget.TelegramHost.Button"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/tvLogs" android:text="Waiting for logs..."
        android:textColor="@color/success" android:fontFamily="monospace" android:textSize="11sp"
        android:padding="12dp" android:background="@color/bg_card"
        android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
