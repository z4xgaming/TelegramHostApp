<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout android:orientation="vertical" android:padding="15dp"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="📜 All Bot Logs" android:textColor="@color/text_primary"
                android:textSize="22sp" android:textStyle="bold" android:layout_gravity="center_vertical"
                android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <Button android:id="@+id/btnRefreshLogs" android:text="🔄" style="@style/Widget.TelegramHost.Button"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/tvAllLogs" android:text="> All bots logs...\n>"
            android:textColor="@color/terminal_text" android:fontFamily="monospace" android:textSize="10sp"
            android:padding="12dp" android:background="@color/terminal_bg"
            android:scrollbars="vertical" android:layout_marginTop="12dp" android:paddingBottom="80dp"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_gravity="bottom"
        android:background="@color/bg_card"
        app:itemIconTint="@color/accent"
        app:itemTextColor="@color/accent"
        app:menu="@menu/bottom_nav_menu"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
